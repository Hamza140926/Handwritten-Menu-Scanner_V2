# Cloudinary is best-effort: scans still work when these are unset.
CLOUDINARY_UPLOAD_ENABLED=1
# Preferred: copy the CLOUDINARY_URL shown in the Cloudinary dashboard.
CLOUDINARY_URL=

# Or set the three values separately:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bump when the inference pipeline/configuration materially changes.
SCANTOSEE_MODEL_VERSION=trocr-menu-v1
